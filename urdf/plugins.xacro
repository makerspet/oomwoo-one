<?xml version="1.0"?>
<!-- https://gazebosim.org/docs/latest/migrating_gazebo_classic_ros2_packages/ -->
<!-- Turtlebot3 Jazzy https://emanual.robotis.com/docs/en/platform/turtlebot3/simulation/ -->
<!-- Build URDF xacro robot.urdf.xacro -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- BOTH odom sources are always published, so a later node can diff them to
       measure wheel slip. odom_source only picks which one owns the CANONICAL
       /odom + /tf (odom to base_footprint) that the stack uses:
         * ground_truth (default): ground truth owns /odom + /tf; wheel odom is
           on /odom_wheel.
         * robot_wheels: wheel odom owns /odom + /tf; ground truth is on
           /odom_truth.
       Ground truth is the true model pose (slip free: a slipping or blocked wheel
       does NOT move it). Wheel odometry is integrated from the actual wheel joint
       rotation like real encoders, so slip shows up as drift. The non-canonical
       source always lands on a fixed /odom_wheel or /odom_truth topic. Default
       (ground_truth) keeps /odom + /tf identical to before, so nothing downstream
       breaks; set odom_source:=robot_wheels at spawn time (world.launch.py). -->
  <xacro:arg name="odom_source" default="ground_truth"/>

  <!-- Per-sensor on/off switches (default all on). The RENDERING sensors (the
       cameras and the front ToF most of all, then the two side ranges and the
       LiDAR) are what slow Gazebo down; turn the ones you don't need off at spawn
       time to speed the sim up (e.g. world.launch.py enable_cameras:=false
       enable_tof:=false). The sensor LINKS stay in the model (TF/visuals intact);
       only the gz sensor (the render cost) is dropped. Contacts, odom, diff drive
       and joint states are always on (cheap). -->
  <xacro:arg name="enable_lidar" default="true"/>
  <xacro:arg name="enable_ranges" default="true"/>
  <xacro:arg name="enable_tof" default="true"/>
  <xacro:arg name="enable_cameras" default="false"/>
  <xacro:arg name="enable_imu" default="true"/>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${wheel_base}</wheel_separation>
      <wheel_radius>${wheel_diameter/2}</wheel_radius>
      <max_linear_acceleration>${max_linear_acceleration}</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <!-- Wheel-encoder odometry, always published. It owns /odom (+ /tf) only when
           selected; otherwise it goes to /odom_wheel for slip comparison and leaves
           /tf to the ground-truth publisher. -->
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <xacro:if value="${'$(arg odom_source)' == 'robot_wheels'}">
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
      </xacro:if>
      <xacro:unless value="${'$(arg odom_source)' == 'robot_wheels'}">
        <odom_topic>/odom_wheel</odom_topic>
      </xacro:unless>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <!-- Ground-truth (true model pose) odometry, always published. Owns /odom
           (+ /tf) when selected; otherwise /odom_truth, with its TF sent to an
           unbridged topic so the wheel odom owns /tf. -->
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
      <xacro:if value="${'$(arg odom_source)' == 'robot_wheels'}">
        <odom_topic>/odom_truth</odom_topic>
        <tf_topic>tf_truth</tf_topic>
      </xacro:if>
      <xacro:unless value="${'$(arg odom_source)' == 'robot_wheels'}">
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
      </xacro:unless>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <!-- update_rate>30</update_rate -->
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>

    <!-- The Contact system is a WORLD-level system in gz-sim; declaring it here
         at model level is a no-op (verified: contacts never fire in a world that
         lacks the world-level plugin, even though the sensor and topic exist).
         The world MUST load it:
           <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
         Both worlds OOMWOO ships already do (oomwoo_sim_support test_room.world and
         oomwoo_gazebo living_room.world). It is kept here as documentation of the
         dependency; remove it and nothing changes. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
  </gazebo>

  <!-- Lists the facet collision names for one bumper half, for the contact sensor.
       These MUST be the post-lump names: the URDF->SDF parser lumps every fixed-joint
       child into the canonical root (base_footprint) and renames each collision to
       <root>_fixed_joint_lump__<name>_collision_<N>, where N is the collision's
       document-order index within the lump (the first, the base_link body cylinder,
       is index 0 and gets no suffix; the 12 bumper facets are 1..12). A gz contact
       sensor referencing the pre-lump name (bumper_left_0) silently never fires.
       If you add/remove/reorder base_link collisions, N shifts and these break;
       the test in test/test_bumper_wiring.py catches that. To regenerate the names:
         xacro robot.urdf.xacro | gz sdf -p /dev/stdin | grep 'collision name' -->
  <xacro:macro name="bumper_facet_collisions" params="prefix n lump_base i:=0">
    <xacro:if value="${i &lt; n}">
      <collision>base_footprint_fixed_joint_lump__${prefix}_${i}_collision_${lump_base + i}</collision>
      <xacro:bumper_facet_collisions prefix="${prefix}" n="${n}" lump_base="${lump_base}" i="${i + 1}"/>
    </xacro:if>
  </xacro:macro>

  <!-- Front bumper contact sensors. Each half watches all of its arc-facet
       collisions on base_link (see robot.urdf.xacro) and publishes gz.msgs.Contacts.
       NOTE: gz-sim ignores the <topic> below for contact sensors and publishes only
       to the scoped name /world/<world>/model/<model>/link/base_footprint/sensor/
       <sensor>/contact, which config/gz_bridge.yaml bridges verbatim. -->
  <gazebo reference="base_link">
    <sensor name="bumper_left" type="contact">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <contact>
        <xacro:bumper_facet_collisions prefix="bumper_left" n="${bumper_facets_per_side}" lump_base="1"/>
      </contact>
      <topic>bumper_left/contact</topic>
    </sensor>
    <sensor name="bumper_right" type="contact">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <contact>
        <xacro:bumper_facet_collisions prefix="bumper_right" n="${bumper_facets_per_side}" lump_base="${1 + bumper_facets_per_side}"/>
      </contact>
      <topic>bumper_right/contact</topic>
    </sensor>
  </gazebo>

  <!-- gazebo reference="laser_frame" -->
  <xacro:if value="${'$(arg enable_lidar)' == 'true'}">
  <gazebo reference="base_scan">
    <sensor name="laser_scan_sensor" type="gpu_lidar">
    <!-- sensor type="ray" name="laser_scan_sensor" -->
      <pose relative_to="base_scan"> 0 0 0 0 0 0 </pose>
      <update_rate>5</update_rate>
      <topic>scan</topic>
      <gz_frame_id>base_scan</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>${2*pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>${lidar_min_range}</min>
          <max>10.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
  </xacro:if>

  <!-- Left/right side distance sensors: a single ray straight out to the side,
       modelling a short-range IR/ToF wall sensor. gz-sim publishes gz.msgs.LaserScan
       (one beam) on <topic>, which config/gz_bridge.yaml bridges to sensor_msgs/
       LaserScan. Attached to the sensor link (see robot.urdf.xacro); like the
       gpu_lidar above, gz honours <topic> (unlike the contact sensors). -->
  <xacro:macro name="side_range_plugin" params="prefix side_sign">
    <gazebo reference="base_link">
      <sensor name="${prefix}" type="gpu_lidar">
        <!-- Pose baked relative to base_link (the canonical link, unaffected by
             fixed-joint lumping) so the ray aim does not depend on the lumped
             sensor-link frame orientation. Matches the ${prefix}_link URDF joint. -->
        <pose relative_to="base_link">${range_sensor_x} ${side_sign * base_diameter/2} ${range_sensor_z} 0 0 ${side_sign * range_sensor_angle_deg * DEG2RAD}</pose>
        <update_rate>${range_sensor_update_rate}</update_rate>
        <topic>${prefix}</topic>
        <gz_frame_id>${prefix}_link</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>${range_sensor_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${-range_sensor_fov_deg/2 * DEG2RAD}</min_angle>
              <max_angle>${ range_sensor_fov_deg/2 * DEG2RAD}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${range_sensor_min}</min>
            <max>${range_sensor_max}</max>
            <resolution>${range_sensor_resolution}</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:if value="${'$(arg enable_ranges)' == 'true'}">
    <xacro:side_range_plugin prefix="range_left" side_sign="1"/>
    <xacro:side_range_plugin prefix="range_right" side_sign="-1"/>
  </xacro:if>

  <!-- Front multizone ToF depth sensor: a 16 (= 8 + 8) x 8 gpu_lidar ray grid over
       120 deg H x 60 deg V, front & center, modelling two VL53L7CX (each 8x8, 60
       deg) aimed +/-30 deg. gz publishes a gz.msgs.PointCloudPacked on tof_front/
       points, which config/gz_bridge.yaml bridges to sensor_msgs/PointCloud2. -->
  <xacro:if value="${'$(arg enable_tof)' == 'true'}">
  <gazebo reference="tof_front_link">
    <sensor name="tof_front" type="gpu_lidar">
      <pose relative_to="tof_front_link">0 0 0 0 0 0</pose>
      <update_rate>${tof_front_update_rate}</update_rate>
      <topic>tof_front</topic>
      <gz_frame_id>tof_front_link</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>${tof_front_h_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${-tof_front_hfov_deg/2 * DEG2RAD}</min_angle>
            <max_angle>${ tof_front_hfov_deg/2 * DEG2RAD}</max_angle>
          </horizontal>
          <vertical>
            <samples>${tof_front_v_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${-tof_front_vfov_deg/2 * DEG2RAD}</min_angle>
            <max_angle>${ tof_front_vfov_deg/2 * DEG2RAD}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${tof_front_min}</min>
          <max>${tof_front_max}</max>
          <resolution>${tof_front_resolution}</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
  </xacro:if>

  <!-- One front RGB camera (OV5647-equivalent), VGA, wide FoV. gz publishes
       gz.msgs.Image on <topic> and gz.msgs.CameraInfo on the sibling camera_info
       topic (the /image suffix -> /camera_info); config/gz_bridge.yaml bridges both.
       The image is stamped in the ROS optical frame. -->
  <xacro:macro name="camera_plugin" params="side">
    <gazebo reference="camera_${side}_link">
      <sensor name="camera_${side}" type="camera">
        <pose relative_to="camera_${side}_link">0 0 0 0 0 0</pose>
        <update_rate>${camera_update_rate}</update_rate>
        <topic>camera_${side}/image</topic>
        <gz_frame_id>camera_${side}_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>${camera_hfov_deg * DEG2RAD}</horizontal_fov>
          <image>
            <width>${camera_width}</width>
            <height>${camera_height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>${camera_near}</near>
            <far>${camera_far}</far>
          </clip>
          <optical_frame_id>camera_${side}_optical_frame</optical_frame_id>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:if value="${'$(arg enable_cameras)' == 'true'}">
    <xacro:camera_plugin side="left"/>
    <xacro:camera_plugin side="right"/>
  </xacro:if>

  <!-- IMU: 6-axis (gyro + accelerometer) at imu_link, near the body center. gz
       publishes gz.msgs.IMU on <topic>, bridged to sensor_msgs/Imu. Orientation
       is ENABLED, so /imu also carries the true attitude quaternion. The physical
       Proscenic gyro reports no absolute orientation, but the sim can and it is
       handy for development; IMU fusion in the EKF stays OFF for now
       (config/ekf.yaml), so /imu does not affect the odom->base TF either way.
       Like the contact sensors, this needs the world to load the world-level
       gz-sim-imu-system; oomwoo_gazebo living_room.world and oomwoo_sim_support
       test_room.world both do (an IMU-less world leaves /imu silent). -->
  <xacro:if value="${'$(arg enable_imu)' == 'true'}">
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <pose relative_to="imu_link">0 0 0 0 0 0</pose>
      <update_rate>${imu_update_rate}</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <enable_orientation>true</enable_orientation>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise}</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise}</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise}</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise}</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise}</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise}</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <always_on>1</always_on>
    </sensor>
  </gazebo>
  </xacro:if>
</robot>
